{
  "info": {
    "_postman_id": "83921d91-e158-4e7e-9b9d-68ecf2eb819d",
    "name": "OrderFlow - Autenticação e Produtos",
    "description": "Coleção para validar manualmente a autenticação e a Task 5 de produtos. Antes de executar: inicie a API, execute o seed e preencha a variável adminPassword com a mesma senha usada em SEED_ADMIN_PASSWORD. Execute a coleção na ordem apresentada para que os tokens e o productId sejam preenchidos automaticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Infraestrutura",
      "item": [
        {
          "name": "Health - deve retornar 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna o status da aplicação', function () {",
                  "  pm.expect(pm.response.json()).to.eql({ status: 'ok' });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Confirma que a aplicação está respondendo. O health fica fora do prefixo /api/v1."
          }
        }
      ]
    },
    {
      "name": "2. Autenticação",
      "item": [
        {
          "name": "Cadastrar customer - deve retornar 201",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = `${Date.now()}-${Math.floor(Math.random() * 100000)}`;",
                  "pm.collectionVariables.set('customerEmail', `postman.${suffix}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Cria um customer sem expor passwordHash', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user.email).to.eql(pm.collectionVariables.get('customerEmail'));",
                  "  pm.expect(body.user.role).to.eql('CUSTOMER');",
                  "  pm.expect(body.user).not.to.have.property('passwordHash');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{customerName}}\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login customer - deve salvar customerToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna um Bearer token', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('customerToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login admin - deve salvar adminToken",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('adminPassword')) {",
                  "  throw new Error('Preencha a variável adminPassword antes de executar o login do admin.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna e salva o token do admin', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.tokenType).to.eql('Bearer');",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('adminToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        }
      ]
    },
    {
      "name": "3. Produtos - cenários positivos",
      "item": [
        {
          "name": "Listar como customer - deve retornar 200 e apenas ativos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna paginação e somente produtos ativos', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.products).to.be.an('array');",
                  "  pm.expect(body.pagination).to.include({ page: 1, limit: 20 });",
                  "  pm.expect(body.products.every((product) => product.active === true)).to.eql(true);",
                  "  pm.expect(body.products.every((product) => Number.isSafeInteger(product.priceCents))).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=1&limit=20"
          }
        },
        {
          "name": "Criar como admin - deve retornar 201 e salvar productId",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('productName', `Postman Product ${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Cria e salva o produto', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.product.name).to.eql(pm.collectionVariables.get('productName'));",
                  "  pm.expect(body.product.priceCents).to.eql(19990);",
                  "  pm.expect(body.product.active).to.eql(true);",
                  "  pm.expect(body.product.id).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('productId', body.product.id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{productName}}\",\n  \"description\": \"Produto criado pela coleção Postman\",\n  \"priceCents\": 19990,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "Editar como admin - deve desativar e retornar 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Atualiza somente o campo active', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.product.id).to.eql(pm.collectionVariables.get('productId'));",
                  "  pm.expect(body.product.name).to.eql(pm.collectionVariables.get('productName'));",
                  "  pm.expect(body.product.priceCents).to.eql(19990);",
                  "  pm.expect(body.product.active).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        },
        {
          "name": "Listar como customer após desativação - não deve exibir o produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Customer não recebe o produto inativo', function () {",
                  "  const body = pm.response.json();",
                  "  const productId = pm.collectionVariables.get('productId');",
                  "  pm.expect(body.products.some((product) => product.id === productId)).to.eql(false);",
                  "  pm.expect(body.products.every((product) => product.active === true)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=1&limit=100"
          }
        },
        {
          "name": "Listar como admin após desativação - deve exibir o produto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Admin recebe o produto inativo', function () {",
                  "  const body = pm.response.json();",
                  "  const productId = pm.collectionVariables.get('productId');",
                  "  const product = body.products.find((item) => item.id === productId);",
                  "  pm.expect(product).to.exist;",
                  "  pm.expect(product.active).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/products?page=1&limit=100"
          }
        }
      ]
    },
    {
      "name": "4. Produtos - erros esperados",
      "item": [
        {
          "name": "Listar sem token - deve retornar 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retorna status 401', function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Retorna erro padronizado de autenticação', function () {",
                  "  pm.expect(pm.response.json().error.code).to.eql('AUTHENTICATION_REQUIRED');",
                  "});"
