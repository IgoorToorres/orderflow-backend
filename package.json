{
  "name": "orderflow-backend",
  "version": "0.1.0",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:validate": "prisma validate --config prisma7.config.ts",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "prisma:test:generate": "prisma generate --config prisma.test.config.ts",
    "db:check": "tsx scripts/check-database.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "npm run prisma:generate && prisma db seed --config prisma7.config.ts",
    "db:test:up": "docker compose --profile test up -d --wait mysql-test",
    "db:test:down": "docker compose --profile test stop mysql-test",
    "db:test:migrate": "prisma migrate deploy --config prisma.test.config.ts",
    "test:integration": "npm run prisma:test:generate && npm run db:test:up && npm run db:test:migrate && vitest run --config vitest.integration.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "private": true
}
